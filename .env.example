# Copy to an ignored .env.live file and fill existing operator-managed secrets.
# This file does not create tokens. Tokens: at least 16 characters, no line breaks.
ML_SERVICE_TOKEN=
GENERATOR_SERVICE_TOKEN=
# URI-safe password: letters, digits, dot, underscore, tilde or hyphen.
# Do not use generator-local. Changing this value does not rotate an existing DB role.
GENERATOR_POSTGRES_PASSWORD=

# Keep these settings and the Compose project names stable for an existing run.
GENERATOR_RUN_KEY=default
GENERATOR_START=2026-01-01T00:00:00Z
GENERATOR_DAYS=365
GENERATOR_ACCOUNTS=50
GENERATOR_SEED=20261024
GENERATOR_PAYMENT_TERMS=hour,day,month
GENERATOR_TIME_SCALE=60
GENERATOR_TICK_SECONDS=1
GENERATOR_MAX_STEP_SECONDS=3600

GENERATOR_HTTP_PORT=8011
ML_HTTP_PORT=8012
GENERATOR_IMAGE_TAG=local
ML_IMAGE_TAG=local
